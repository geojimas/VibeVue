{
  "name": "vue3-starter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview --host",
    "lint": "eslint . --fix",
    "tests": "vitest run",
    "tests:coverage": "vitest run --coverage",
    "tests:clearCache": "vitest run --clearCache",
    "check": "npm run tests:clearCache && npm run lint && npm run tests",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.50",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "baseline-browser-mapping": "^2.11.33",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
