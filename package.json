{
  "name": "vue3-starter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview --host",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "check": "npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.43",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "baseline-browser-mapping": "^2.11.25",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "vue-eslint-parser": "^10.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "vite": "^8.3.0",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^5.0.1"
  }
